{
  "manifest_version": 3,
  "name": "Better Amazon Lists",
  "version": "0.2.0",
  "description": "Compact, multi-column layout for Amazon wish lists: more items on screen, same details and controls.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Better Amazon Lists",
    "default_popup": "popup.html"
  },
